# Arch: builds the Arch tarball and signet-gtk-bin from it with makepkg.
FROM archlinux:latest
ARG UID=1000
ARG SWIFT_VERSION
ARG SWIFTLY_PLATFORM=

RUN pacman -Syu --noconfirm --needed \
        ca-certificates curl git gnupg tzdata xz unzip file \
        base-devel libedit ncurses python sqlite libxml2 libxml2-legacy util-linux-libs \
        pkgconf gtk4 libadwaita webkitgtk-6.0 hidapi libwebp zlib \
    && pacman -Scc --noconfirm
# swift.org's UBI 9 toolchain asks for libncurses.so.6, as RHEL names it; Arch has the
# wide-character library alone (and libtinfo.so.6 already pointing at it).
RUN ln -s libncursesw.so.6 /usr/lib/libncurses.so.6

RUN useradd -m -u "$UID" builder \
    && install -d -o builder -g builder /work /work/.build /work/dist
COPY install-swift.sh /usr/local/bin/install-swift
USER builder
RUN SWIFT_VERSION="$SWIFT_VERSION" SWIFTLY_PLATFORM="$SWIFTLY_PLATFORM" install-swift
WORKDIR /work
