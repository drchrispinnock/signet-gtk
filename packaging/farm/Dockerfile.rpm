# Fedora: builds the RPM. swift.org's toolchain for Fedora 41 wants libxml2.so.2, which Fedora 45
# keeps in libxml2_2.13.
ARG BASE=fedora:45
FROM ${BASE}
ARG UID=1000
ARG SWIFT_VERSION
ARG SWIFTLY_PLATFORM=

RUN dnf install -y --setopt=install_weak_deps=False \
        ca-certificates curl git gnupg2 tzdata xz unzip file findutils diffutils \
        binutils gcc gcc-c++ glibc-devel libstdc++-devel libstdc++-static libcurl-devel \
        libedit-devel ncurses-devel python3-devel sqlite-devel libxml2-devel libuuid-devel \
        libxml2_2.13 \
        pkgconf gtk4-devel libadwaita-devel javascriptcoregtk6.0-devel webkitgtk6.0-devel \
        hidapi-devel libwebp-devel zlib-ng-compat-devel rpm-build \
    && dnf clean all

RUN useradd -m -u "$UID" builder \
    && install -d -o builder -g builder /work /work/.build /work/dist
COPY install-swift.sh /usr/local/bin/install-swift
USER builder
RUN SWIFT_VERSION="$SWIFT_VERSION" SWIFTLY_PLATFORM="$SWIFTLY_PLATFORM" install-swift

# Swift Build asks ld its version and knows Fedora's banner only with a release after the version
# ("GNU ld version 2.41-37.fc40"); Fedora 45's has none ("2.47.20260726"), so the build fails.
# gold's banner it reads, so gold is ld here.
USER root
RUN dnf install -y binutils-gold && dnf clean all && alternatives --set ld /usr/bin/ld.gold
USER builder
WORKDIR /work
